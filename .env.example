# Copie para .env e preencha com as credenciais reais.
# O .env NUNCA deve ser versionado.

# PostgreSQL (metadados: empresa, unidade, ativo, ponto)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# DynamoDB (séries de temperatura)
# Deixe DYNAMODB_ENDPOINT vazio para usar o endpoint padrão da AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_EVENTS=retina-global-charts

# Correção subtraída de toda leitura de temperatura, em °C
TEMPERATURE_OFFSET_C=6.8

# Aceleração RMS mínima, em g, para o sensor contar como montado na máquina.
# Padrão global; cada ativo pode ter o seu, ajustado na tela Analytics.
MOUNTED_MIN_ACC_G=0.03

# Quanto o sensor suspeito precisa estar mais frio que o par, em °C, para
# confirmar que está fora da máquina. Segunda evidência da regra.
OFF_MACHINE_MIN_TEMP_GAP_C=10

# Porta da API
PORT=4000
