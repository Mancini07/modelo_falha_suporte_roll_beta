# Copie para .env e preencha com as credenciais reais.
# O .env NUNCA deve ser versionado.

# PostgreSQL (metadados: empresa, unidade, ativo, ponto)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# DynamoDB (séries de temperatura)
# Deixe DYNAMODB_ENDPOINT vazio para usar o endpoint padrão da AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_EVENTS=retina-global-charts

# Correção subtraída de toda leitura de temperatura, em °C
TEMPERATURE_OFFSET_C=6.8

# Porta da API
PORT=4000
